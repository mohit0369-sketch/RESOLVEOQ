# ---------------------------------------------------------------------------
# Student 2 — Intelligence Engine — environment template
#
# The core intelligence pipeline runs 100% LOCALLY and needs NO API keys.
# Copy this file to `.env` only if you want to override the defaults below.
# (`.env` is git-ignored.)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Embedding backend selection
#   auto                  (default) use sentence-transformers if the model can be
#                         loaded, otherwise fall back to the offline hashing backend
#   sentence-transformers force the transformer model (raises EmbeddingError if it
#                         cannot be loaded - use this in CI to fail loudly)
#   hashing               force the deterministic, offline, dependency-free backend
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=auto

# Sentence-Transformers model id (384-dim by default).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Trend / emerging-issue defaults (also settable via CLI flags)
# ---------------------------------------------------------------------------
# Growth (%) above which an issue is flagged as emerging
EMERGING_GROWTH_THRESHOLD=25

# Minimum complaints in the current period for an emerging-issue flag
EMERGING_MIN_COUNT=3

# ---------------------------------------------------------------------------
# NO API KEYS REQUIRED.
# Student 2 deliberately does not call OpenAI / Gemini / any external service:
# the engine must work offline during the hackathon demo. Student 3 owns all
# LLM-based decision making and credentials.
# ---------------------------------------------------------------------------
